<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Unleashing_Potential.SiteMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Unleashing Potential</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Nunito:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    
    <style>
        :root {
            --sky:        #0ea5e9;
            --sky-dark:   #0369a1;
            --sky-deeper: #0c4a6e;
            --sky-light:  #bae6fd;
            --sky-pale:   #f0f9ff;
            --accent:     #f59e0b;
            --text:       #0f172a;
            --muted:      #64748b;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background-color: var(--sky-pale);
            color: var(--text);
        }

        
        .navbar {
            background-color: var(--sky-deeper) !important;
            border-bottom: 3px solid var(--accent);
        }

        .navbar-brand {
            font-family: 'Lora', serif;
            color: #f0f9ff !important;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .nav-logo {
            height: 34px;
            border-radius: 5px;
        }

        .nav-link {
            color: var(--sky-light) !important;
            font-weight: 500;
        }

        .nav-link:hover {
            color: var(--accent) !important;
        }

       
        .site-header {
            background: linear-gradient(135deg, var(--sky-dark), var(--sky-deeper));
            padding: 1.5rem 0;
            text-align: center;
        }

        .header-inner {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .header-logo {
            height: 70px;
            margin-bottom: 10px;
            border-radius: 8px;
        }

        .header-text h1 {
            font-family: 'Lora', serif;
            font-size: 1.8rem;
            color: #f0f9ff;
            margin: 0;
        }

        .header-text p {
            color: var(--sky-light);
            font-size: 0.9rem;
            margin: 0;
        }

        main {
            min-height: calc(100vh - 200px);
        }

        footer {
            background-color: var(--sky-deeper);
            color: var(--sky-light);
            font-size: 0.85rem;
            padding: 2rem 0;
            margin-top: 3rem;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="Default.aspx">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="Register.aspx">Register</a></li>
                    <li class="nav-item"><a class="nav-link" href="Login.aspx">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="Admin.aspx">Admin</a></li>
                    <li class="nav-item"><a class="nav-link" href="Services.aspx">Services</a></li>
                    <li class="nav-item"><a class="nav-link" href="About.aspx">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="Contact.aspx">Contact Us</a></li>
                </ul>
            </div>
        </div>
    </nav>

  
    <header class="site-header">
        <div class="header-inner">
            <img src="~/Images/Unleashing Potential Logo.jpeg" runat="server" class="header-logo" />
            <div class="header-text">
                <h1>Group 4 - Unleashing Potential</h1>
                <p>A local Kasi Service near you.</p>
            </div>
        </div>
    </header>

    <main class="container py-4">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="text-center">
        <p><strong>Group 4 — Unleashing Potential</strong></p>
        <p>© <%: DateTime.Now.Year %> All rights reserved.</p>
        <p>
            <i class="bi bi-envelope"></i> unleashingpotential@gmail.com
            <i class="bi bi-telephone"></i> +27 73 123 4567
        </p>
    </footer>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>